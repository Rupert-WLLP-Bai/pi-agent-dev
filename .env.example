# OpenAI-compatible LLM endpoint consumed by the Pi provider adapter.
# The 模型服务 page (/settings/providers) can override these at runtime; this
# environment block remains the fallback whenever no provider exists in the DB.
XYG_ENDPOINT=
XYG_API_KEY=
XYG_MODEL=
XYG_MAX_INPUT=128000
XYG_MAX_OUTPUT=4096

# ---------------------------------------------------------------------------
# Runtime environment and access gate
# ---------------------------------------------------------------------------
# development | test | demo | production. Decides three things: whether the
# demo reset is permitted (demo/test only), whether the access token and key
# encryption secret are required at startup (demo/production), and whether the
# object store runs in strict mode. Unknown values are refused by demo guards;
# use one of these exact environment names.
APP_ENV=development

# Workspace authentication is deferred; the workbench opens directly.
# Ordinary runtime encryption secret, required in demo/production (>=32 chars).
# NEXT is maintenance-only; see docs/runbook/key-rotation.md.
LLM_KEY_ENCRYPTION_SECRET=

# Origins permitted to receive raw contract text on an outbound model call.
# Empty (the default) means no external origin may receive a non-fixture
# contract; loopback alone is not treated as an exemption, because a gateway
# reachable at 127.0.0.1 may still forward data onward. Comma-separated origins.
LLM_INTERNAL_DATA_ORIGINS=

# Local infrastructure (PostgreSQL + API runtime).
DATABASE_URL=postgresql://contract_audit:contract_audit@localhost:5432/contract_audit
MAX_CONCURRENT_AUDITS=1
# Per-run ceiling for one agent run; 0 disables the ceiling entirely. A clean
# run against the configured remote endpoint measured ~62s across ~20 tool
# calls, so the default leaves ample headroom; raise it for a slower endpoint,
# since an aborted run is recorded as a failed agent run and nothing resumes it.
AGENT_TIMEOUT_MS=900000
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# "pi" runs the constrained real agent; "fake" runs FakeAuditAgent (no credentials needed).
AUDIT_AGENT_MODE=pi

# ---------------------------------------------------------------------------
# Object storage for contract originals
# ---------------------------------------------------------------------------
# Optional infrastructure — S3-compatible object storage for contract originals.
# Leave S3_ENDPOINT empty for local development: originals are written to
# UPLOAD_DIR on disk instead. That is the normal local state, not an error.
# Set it (RustFS/S3) to persist originals in the object store; the locator prefix
# on each Source Record (s3://bucket/key vs a filesystem path) records the backend.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=contract-originals
S3_REGION=us-east-1
# Demo/production require S3 writes, including when no endpoint is configured.
# Development/test may select S3_STRICT=false for explicit local fallback.
# Historical local locators remain readable after strict S3 is enabled.
S3_STRICT=
# Per-request ceiling for object-store calls, in milliseconds. 0 or empty
# disables the client-side timeout (the SDK default applies).
S3_TIMEOUT_MS=10000
# Local originals for development or explicitly enabled development fallback.
UPLOAD_DIR=var/uploads

# ---------------------------------------------------------------------------
# Demo environment identity (guarded reset)
# ---------------------------------------------------------------------------
# The demo reset (CLI `reset`/`seed`, DELETE /api/demo/world) deletes rows, so
# it runs only when all three hold: APP_ENV is demo or test, DEMO_RESET_CONFIRMATION
# equals DEMO_DATABASE_NAME exactly, and the connected database both is that name
# and has a registered demo_environments row under DEMO_ENVIRONMENT_ID.
# `bun run demo:up` manages a separate protected .demo.env and demo stack.
DEMO_ENVIRONMENT_ID=
DEMO_DATABASE_NAME=
DEMO_RESET_CONFIRMATION=
# Demo world shape: extra filler cases and the fixed RNG seed. The same seed
# always produces the same world, which is what makes a demo reproducible.
DEMO_FILLER_COUNT=
DEMO_RNG_SEED=
# Largest accepted upload, in bytes. Anything larger is refused with 413 before
# any parsing work is attempted.
MAX_UPLOAD_BYTES=10485760

# Optional infrastructure — Redis cache for 企查查 subject verification only.
# Leave REDIS_URL empty to disable the cache: verification then calls the
# provider directly. Unset/unreachable Redis never fails an audit.
# That is the normal local state, not an error.
REDIS_URL=

# Subject verification: "fixture" = deterministic test data, "qcc" = real Qichacha MCP API.
SUBJECT_VERIFICATION_MODE=fixture
QCC_TOKEN=
# Optional overrides; defaults point at the public MCP stream endpoints.
QCC_COMPANY_ENDPOINT=https://agent.qcc.com/mcp/company/stream
QCC_RISK_ENDPOINT=https://agent.qcc.com/mcp/risk/stream

# Contract Stance: name fragments identifying our own organization, comma
# separated. Substring matching, because contracts write the same entity many
# ways ("中国移动通信集团重庆有限公司两江新区分公司" vs "重庆移动").
# Which side of the money we are on decides which rules apply and which side of
# a price sheet a contract total is reconciled against. Leave empty and no
# stance is inferred: every rule runs as it did before stance existed, because a
# wrong stance silences rules and that is worse than not narrowing.
OWN_ORGANIZATION_NAMES=

# Scanned-contract recognition. These variables are the BOOTSTRAP only: with no
# saved OCR settings row the recognizer is built from them, and the first save
# on the OCR settings page (/settings/ocr) carries them into storage. Once a
# row is saved it is the configuration in force and survives a restart; "off"
# leaves scans unreadable, "vlm" sends page images to an OpenAI-compatible
# vision endpoint, "mineru" calls a MinerU 4.x service (/v1/file_parse).
OCR_PROVIDER=off
OCR_VLM_ENDPOINT=
OCR_VLM_API_KEY=
OCR_VLM_MODEL=
# Retried with when the primary model truncates a dense page (finish_reason=length).
OCR_VLM_FALLBACK_MODEL=
# Page cap per contract, render scale (below 2 the strokes of small CJK glyphs merge),
# JPEG quality, and how many pages are recognized in parallel.
OCR_MAX_PAGES=40
OCR_SCALE=2
OCR_JPEG_QUALITY=85
OCR_CONCURRENCY=3
OCR_TIMEOUT_MS=120000
# MinerU service root (NOT .../v1 — the adapter appends /v1 itself).
MINERU_ENDPOINT=

# Tavily search API (research only).
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Decision shadow (assistive advice; never writes formal results)
# ---------------------------------------------------------------------------
# off: nothing is created, claimed or called; existing history stays readable.
# shadow: the independent worker records advice for later evaluation.
DECISION_MODE=off
# disabled | fake | laya-cpu. "fake" is an explicitly labelled offline demo
# provider; "laya-cpu" is the controlled local CPU service.
DECISION_PROVIDER=disabled
# Endpoint comes from server configuration only. Empty with DECISION_MODE=shadow
# means the provider is not configured and nothing is called.
DECISION_ENDPOINT=
# Comma-separated allowlist of origins the provider may be called at. Empty
# means no origin is permitted. Loopback alone is not an exemption.
DECISION_ALLOWED_ORIGINS=
# Pinned local Laya model identity. Recorded on every advice row so a result
# can always be traced to the exact code and weights that produced it.
DECISION_MODEL=multilingual
DECISION_MODEL_REVISION=1720e3e3357cfe1e281542e223f8273b0890ca34
DECISION_CODE_REVISION=432312b36714d8889eba405507b37eda25257d9c
# Per-request ceiling, worker poll interval, bounded retries, bounded
# concurrency and the lease duration a claimed job holds.
DECISION_TIMEOUT_MS=10000
DECISION_POLL_INTERVAL_MS=2000
DECISION_MAX_RETRIES=2
DECISION_CONCURRENCY=1
DECISION_LEASE_MS=60000
# Retention for terminal shadow records and their feedback only, in days
# (1–365). Never applies to Source Records, snapshots, runs, findings,
# reviews or remediations.
DECISION_RETENTION_DAYS=30
