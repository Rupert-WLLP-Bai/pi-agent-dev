# OpenAI-compatible LLM endpoint consumed by the Pi provider adapter.
XYG_ENDPOINT=
XYG_API_KEY=
XYG_MODEL=
XYG_MAX_INPUT=128000
XYG_MAX_OUTPUT=4096

# Local MVP infrastructure.
DATABASE_URL=postgresql://contract_audit:contract_audit@localhost:5432/contract_audit
MAX_CONCURRENT_AUDITS=1
AGENT_TIMEOUT_MS=300000
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# "pi" runs the constrained real agent; "fake" runs FakeAuditAgent (no credentials needed).
AUDIT_AGENT_MODE=pi


# Subject verification: "fixture" = deterministic test data, "qcc" = real Qichacha MCP API.
SUBJECT_VERIFICATION_MODE=fixture
QCC_TOKEN=
# Optional overrides; defaults point at the public MCP stream endpoints.
QCC_COMPANY_ENDPOINT=https://agent.qcc.com/mcp/company/stream
QCC_RISK_ENDPOINT=https://agent.qcc.com/mcp/risk/stream

# Tavily search API (research only).
TAVILY_API_KEY=
