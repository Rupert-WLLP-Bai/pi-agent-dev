# OpenAI-compatible LLM endpoint consumed by the Pi provider adapter.
# The 模型服务 page (/settings/providers) can override these at runtime; this
# environment block remains the fallback whenever no provider exists in the DB.
XYG_ENDPOINT=
XYG_API_KEY=
XYG_MODEL=
XYG_MAX_INPUT=128000
XYG_MAX_OUTPUT=4096

# Local infrastructure (PostgreSQL + API runtime).
DATABASE_URL=postgresql://contract_audit:contract_audit@localhost:5432/contract_audit
MAX_CONCURRENT_AUDITS=1
# Per-run ceiling for one agent run; 0 disables the ceiling entirely. A clean
# run against the configured remote endpoint measured ~62s across ~20 tool
# calls, so the default leaves ample headroom; raise it for a slower endpoint,
# since an aborted run is recorded as a failed agent run and nothing resumes it.
AGENT_TIMEOUT_MS=900000
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# "pi" runs the constrained real agent; "fake" runs FakeAuditAgent (no credentials needed).
AUDIT_AGENT_MODE=pi

# Optional infrastructure — S3-compatible object storage for contract originals.
# Leave S3_ENDPOINT empty for local development: originals are written to
# UPLOAD_DIR on disk instead. That is the normal local state, not an error.
# Set it (MinIO/S3) to persist originals in the object store; the locator prefix
# on each Source Record (s3://bucket/key vs a filesystem path) records the backend.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=contract-originals
S3_REGION=us-east-1
# Local fallback directory, used when S3_ENDPOINT is unset or an upload fails.
UPLOAD_DIR=var/uploads

# Optional infrastructure — Redis cache for 企查查 subject verification only.
# Leave REDIS_URL empty to disable the cache: verification then calls the
# provider directly. Unset/unreachable Redis never fails an audit.
# That is the normal local state, not an error.
REDIS_URL=

# Subject verification: "fixture" = deterministic test data, "qcc" = real Qichacha MCP API.
SUBJECT_VERIFICATION_MODE=fixture
QCC_TOKEN=
# Optional overrides; defaults point at the public MCP stream endpoints.
QCC_COMPANY_ENDPOINT=https://agent.qcc.com/mcp/company/stream
QCC_RISK_ENDPOINT=https://agent.qcc.com/mcp/risk/stream

# Tavily search API (research only).
TAVILY_API_KEY=
