{
  "name": "contract-audit-mvp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "bun --env-file=.env test packages apps",
    "test:unit": "bun --env-file=.env test packages apps",
    "test:integration": "bun --env-file=.env test tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "bun --env-file=.env test --coverage --coverage-reporter=lcov --coverage-dir=artifacts/qa/coverage packages apps",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "qa:report": "bun scripts/qa/report.ts",
    "qa:faults": "bun scripts/qa/faults.ts",
    "qa:coverage": "bun scripts/qa/coverage.ts",
    "secrets:rotate": "bun --env-file=.env apps/api/src/llm/rotate-api-keys.ts",
    "demo:up": "bun --env-file=.env scripts/demo/cli.ts up",
    "demo:down": "bun --env-file=.env scripts/demo/cli.ts down",
    "demo:reset": "bun --env-file=.env scripts/demo/cli.ts reset",
    "demo:seed": "bun --env-file=.env scripts/demo/cli.ts seed",
    "demo:verify": "bun --env-file=.env scripts/demo/cli.ts verify",
    "demo:check": "bun --env-file=.env scripts/demo/cli.ts check",
    "demo:ready": "bun --env-file=.env scripts/demo/cli.ts ready",
    "acceptance": "playwright test",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "dev": "bun --filter @contract-audit/api dev",
    "seed:demo": "bun --env-file=.env apps/api/src/demo/seed-cli.ts"
  },
  "devDependencies": {
    "@contract-audit/audit": "workspace:*",
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.50.0",
    "@types/bun": "^1.4.2",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "postgres": "3.4.0",
    "typescript": "^7.0.2"
  }
}
